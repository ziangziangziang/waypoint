{
  "name": "waypoint",
  "version": "0.6.0",
  "private": true,
  "description": "Local OpenAI-compatible reverse proxy with routing, health checks, and playground UI",
  "license": "MIT",
  "main": "dist/src/index.js",
  "bin": {
    "waypoint": "dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "build:ui": "cd ui && npm run build",
    "build:all": "npm run build && npm run build:ui",
    "start": "node dist/src/index.js",
    "cli": "tsx cli/index.ts",
    "seed": "tsx scripts/seed.ts",
    "manual-test": "bash scripts/manual-test.sh"
  },
  "dependencies": {
    "@fastify/static": "^7.0.4",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "commander": "^12.1.0",
    "fastify": "^4.28.1",
    "sharp": "^0.33.5",
    "undici": "^6.19.8",
    "yaml": "^2.4.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
